rules_version = '2';

// Forest Cafe - Firestore security rules
// Everyone can READ the website content and photos. Only the owner can WRITE them.
service cloud.firestore {
  match /databases/{database}/documents {

    // text, prices, availability, photo list
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'gGHezBFVWyN7KCctRZOOXLNIvDE2'
                   && request.resource.data.json is string
                   && request.resource.data.json.size() < 30000;
    }

    // uploaded photos (compressed WebP stored as text, each well under Firestore's 1 MB limit)
    match /site_images/{imageId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == 'gGHezBFVWyN7KCctRZOOXLNIvDE2'
                            && request.resource.data.data is string
                            && request.resource.data.data.size() < 900000
                            && request.resource.data.type in ['image/webp', 'image/jpeg'];
      allow delete: if request.auth != null
                    && request.auth.uid == 'gGHezBFVWyN7KCctRZOOXLNIvDE2';
    }

    // everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
